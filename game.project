[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -700.0
scale = 0.01
debug = 0

[html5]
scale_mode = no_scale
show_console_banner = 0

[project]
title = car
dependencies#0 = https://github.com/indiesoftby/defold-simplex-noise/archive/main.zip

[input]
game_binding = /builtins/input/all.input_bindingc

[native_extension]
app_manifest = /manifest.appmanifest

